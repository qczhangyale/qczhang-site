---
import { getCollection } from 'astro:content';
import { filterEnglishOnly } from '../../i18n';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';

const papers = filterEnglishOnly(await getCollection('papers')).sort(
	(a, b) => a.data.order - b.data.order,
);

const synthesis = papers.filter((p) => p.data.category === 'synthesis');
const cosmology = papers.filter((p) => p.data.category === 'cosmology');
const method = papers.filter((p) => p.data.category === 'method');
const twistor = papers.filter((p) => p.data.category === 'twistor');
const foundations = papers.filter((p) => p.data.category === 'foundations');

const description =
	'All papers in the Twistor Configuration Geometry / Configurable Universe research program.';

const sections = [
	{
		key: 'synthesis',
		title: 'Synthesis',
		subtitle: 'Empirical body, philosophical reading, and architectural-particle argument',
		note: 'Three consolidation papers: the empirical body (DAEDALUS Review, May 2026), the philosophical companion (Configurable Universe, May 2026), and the structural argument that the electron is the framework\'s architectural particle.',
		papers: synthesis,
	},
	{
		key: 'cosmology',
		title: 'Cosmology and Gravity',
		subtitle: 'Founding observations',
		note: 'The cosmological-constant relation, the η formula, the gravitational coupling, and the emergent-gravity expression containing the original spin-1 derivation.',
		papers: cosmology,
	},
	{
		key: 'method',
		title: 'Methodology and Groundwork',
		subtitle: 'How and why',
		note: 'The discovery engine: a constraint-filtered dimensional-analysis search across a privileged-target dictionary, with the structural filter that distinguishes physics-of-amplitudes coincidences from genuine relations.',
		papers: method,
	},
	{
		key: 'twistor',
		title: 'Twistor Framework Discoveries',
		subtitle: 'April 2026 — the geometric breakthrough',
		note: '1/α as a chamber-weighted Fubini–Study sum, the stratified Penrose-volume integral, the electron-Yukawa closed form, the super-flag construction, lepton golden-ratio scaling, and the super-CY reading of Λ.',
		papers: twistor,
	},
	{
		key: 'foundations',
		title: 'Foundations and Adjacent Workstreams',
		subtitle: 'Independent of the TCG empirical arc',
		note: 'TCG framework architecture papers (the construction reference, the predictive ledger, the electroweak-boundary postulate update) together with three independent threads adjacent to the TCG arc: (i) a boundary-defined null-connection interpretation of single-photon events paired with a no-signaling-preserving predictive companion (papers 17–18); (ii) a wall-deletion bridge from TCG chamber data to a Pati–Salam (B−L)/2 sub-algebra (paper 19); (iii) a phenomenological running-fractional-Laplacian model for spectral dimension flow in quantum spacetime (paper 20). The adjacent workstreams have independent Zenodo records and stand distinct from the seventeen-paper TCG arc.',
		papers: foundations,
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Papers — ${SITE_TITLE}`} description={description} />
		<style>
			.page-header {
				max-width: var(--page-width-wide);
				margin: 0 auto;
				padding: 3rem 1rem 1.5rem;
			}
			.page-eyebrow {
				font-family: var(--font-sans);
				font-size: 0.78rem;
				font-weight: 600;
				color: var(--accent);
				letter-spacing: 0.12em;
				text-transform: uppercase;
				margin-bottom: 0.6rem;
			}
			.page-header h1 {
				margin: 0 0 0.4em 0;
				font-size: 2.2rem;
				letter-spacing: -0.02em;
			}
			.page-intro {
				color: var(--text-muted);
				font-size: 1.05rem;
				max-width: 640px;
			}
			.page-summary {
				display: flex;
				gap: 2rem;
				margin-top: 1.5rem;
				flex-wrap: wrap;
			}
			.summary-stat {
				font-family: var(--font-sans);
			}
			.summary-stat .num {
				font-size: 1.6rem;
				font-weight: 700;
				color: var(--accent);
				line-height: 1;
				display: block;
			}
			.summary-stat .label {
				font-size: 0.8rem;
				color: var(--text-faint);
				text-transform: uppercase;
				letter-spacing: 0.08em;
				margin-top: 0.3em;
				display: block;
			}

			.section {
				max-width: var(--page-width-wide);
				margin: 0 auto;
				padding: 2.5rem 1rem 1rem;
			}
			.section-header {
				margin-bottom: 1.2rem;
				padding-bottom: 0.9rem;
				border-bottom: 1px solid var(--border);
			}
			.section-header h2 {
				margin: 0 0 0.2em 0;
				font-size: 1.5rem;
			}
			.section-subtitle {
				font-family: var(--font-sans);
				font-size: 0.82rem;
				color: var(--accent);
				font-weight: 600;
				letter-spacing: 0.04em;
				margin-bottom: 0.5em;
			}
			.section-note {
				color: var(--text-muted);
				font-size: 0.95rem;
				margin: 0;
				max-width: 720px;
			}

			.papers-grid {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
				gap: 1rem;
			}

			.paper-card {
				display: flex;
				flex-direction: column;
				padding: 1.3em 1.4em;
				background: var(--bg-elevated);
				border: 1px solid var(--border);
				border-radius: 8px;
				text-decoration: none;
				color: inherit;
				transition: transform 0.15s, box-shadow 0.15s, border-color 0.15s;
			}
			.paper-card:hover {
				transform: translateY(-1px);
				box-shadow: var(--shadow-md);
				border-color: var(--border-strong);
				text-decoration: none;
			}

			.paper-meta {
				display: flex;
				gap: 0.5rem;
				align-items: center;
				margin-bottom: 0.7em;
				flex-wrap: wrap;
			}
			.paper-num {
				font-family: var(--font-mono);
				font-size: 0.78rem;
				color: var(--text-faint);
			}

			.paper-card h3 {
				margin: 0 0 0.5em 0;
				font-size: 1.05rem;
				line-height: 1.3;
				font-family: var(--font-sans);
			}
			.paper-card .description {
				color: var(--text-muted);
				margin: 0;
				font-size: 0.92rem;
				line-height: 1.55;
				flex: 1;
			}
			.paper-card .doi {
				margin-top: 0.9em;
				padding-top: 0.7em;
				border-top: 1px solid var(--border);
				font-family: var(--font-mono);
				font-size: 0.78rem;
				color: var(--text-faint);
			}
		</style>
	</head>
	<body>
		<Header />
		<div class="page-header">
			<div class="page-eyebrow">Bibliography</div>
			<h1>Papers</h1>
			<p class="page-intro">
				Twenty-one papers in total: a seventeen-paper Twistor Configuration Geometry arc
				plus four adjacent workstreams (BDNC ontology, NBR predictive companion, the TCG →
				Pati–Salam wall-deletion bridge, and a spectral-dimension-flow study of quantum
				spacetime). Published on Zenodo under CC-BY-4.0. The TCG synthesis papers (May
				2026) are the recommended starting point; the adjacent workstreams stand on their
				own.
			</p>
			<div class="page-summary">
				<div class="summary-stat">
					<span class="num">21</span>
					<span class="label">Papers</span>
				</div>
				<div class="summary-stat">
					<span class="num">9</span>
					<span class="label">Empirical relations</span>
				</div>
				<div class="summary-stat">
					<span class="num">124</span>
					<span class="label">Orders of magnitude</span>
				</div>
				<div class="summary-stat">
					<span class="num">1</span>
					<span class="label">Falsifiable prediction</span>
				</div>
			</div>
		</div>

		{
			sections.map((s) => (
				<div class="section">
					<div class="section-header">
						<div class="section-subtitle">{s.subtitle}</div>
						<h2>{s.title}</h2>
						<p class="section-note">{s.note}</p>
					</div>
					<div class="papers-grid">
						{s.papers.map((p) => (
							<a href={`/papers/${p.id}/`} class="paper-card">
								<div class="paper-meta">
									<span class={`badge badge-${p.data.category}`}>
										{p.data.category}
									</span>
									{p.data.precision && (
										<span class="badge-precision">{p.data.precision}</span>
									)}
									<span class="paper-num">№ {String(p.data.order).padStart(2, '0')}</span>
								</div>
								<h3>{p.data.title}</h3>
								<p class="description">{p.data.description}</p>
								<div class="doi">{p.data.doi}</div>
							</a>
						))}
					</div>
				</div>
			))
		}

		<Footer />
	</body>
</html>
