---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { t } from '../../i18n';
import { getPaperCounts } from '../../lib/paper-stats';

const locale = 'zh-tw';
const counts = await getPaperCounts();
// Every number on this page is read from the content collection, so the prose
// cannot drift as records are added.
const vars = {
	total: counts.total,
	cf: counts.cf,
	cfRelease1: counts.cfRelease1,
	cfRelease2: counts.cfRelease2,
	tcg: counts.tcg,
	tcgArc: counts.tcgArc,
	adjacent: counts.adjacent,
};
const bold = (key: string) =>
	t(locale, key, vars).replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
---

<!doctype html>
<html lang="zh-TW" data-theme="warm">
	<head>
		<BaseHead title={`${t(locale, 'about.title')} — Q.C. Zhang`} description={t(locale, 'about.lede')} />
		<style>
			.page-header { padding: 3rem 1rem 1.5rem; border-bottom: 1px solid var(--border); background: var(--bg-subtle); }
			.page-header-inner { max-width: var(--page-width); margin: 0 auto; }
			.page-eyebrow { font-family: var(--font-sans); font-size: 0.78rem; font-weight: 600; color: var(--accent); letter-spacing: 0.12em; text-transform: uppercase; margin-bottom: 0.6rem; }
			.page-header h1 { margin: 0 0 0.3em 0; font-size: 2rem; letter-spacing: -0.02em; }
			.lede { font-family: var(--font-serif); font-size: 1.1rem; color: var(--text-muted); font-style: italic; margin: 0; line-height: 1.5; max-width: 600px; }
			main { max-width: var(--page-width); margin: 0 auto; padding: 2.5rem 1rem 1rem; }
			main p { line-height: 1.75; }
			h2 { margin-top: 2.5em; font-size: 1.25rem; }
			.contact-card { margin-top: 3rem; padding: 1.5em 1.6em; background: var(--bg-subtle); border-left: 3px solid var(--accent); border-radius: 6px; }
			.contact-card h3 { margin: 0 0 0.5em 0; font-size: 1rem; }
			.contact-card p { margin-bottom: 0.5em; color: var(--text-muted); font-size: 0.95rem; }
		</style>
	</head>
	<body>
		<Header />
		<div class="page-header">
			<div class="page-header-inner">
				<div class="page-eyebrow">{t(locale, 'about.eyebrow')}</div>
				<h1>{t(locale, 'about.title')}</h1>
				<p class="lede">{t(locale, 'about.lede')}</p>
			</div>
		</div>

		<main>
			<p set:html={bold('about.intro')}></p>

			<h2>{t(locale, 'about.cf')}</h2>
			<p set:html={bold('about.cfBody')}></p>
			<p><a href="/zh-tw/">瀏覽互補性優先的紀錄 →</a></p>

			<h2>{t(locale, 'about.tcg')}</h2>
			<p set:html={bold('about.framework')}></p>
			<p><a href="/zh-tw/tcg/">瀏覽扭量構型幾何的弧 →</a></p>

			<h2>{t(locale, 'about.empiricalAnchor')}</h2>
			<p set:html={bold('about.empiricalAnchorBody')}></p>

			<h2>{t(locale, 'about.prediction')}</h2>
			<p>
				{t(locale, 'about.predictionBody')} {t(locale, 'about.predictionExtra')}
				詳見<a href="/zh-tw/papers/04-predictions-no-go/">預測與不可行性論文</a>。
			</p>

			<h2>{t(locale, 'about.corpus')}</h2>
			<p>
				{t(locale, 'about.corpusBody', vars)} 詳見<a href="/zh-tw/papers/">完整列表</a>。
			</p>

			<div class="contact-card">
				<h3>{t(locale, 'about.contact')}</h3>
				<p>{t(locale, 'about.contactEmail')}: <a href="mailto:qczhang@aya.yale.edu">qczhang@aya.yale.edu</a></p>
				<p style="margin-bottom: 0;">{t(locale, 'about.contactOpen')}</p>
			</div>
		</main>
		<Footer />
	</body>
</html>
