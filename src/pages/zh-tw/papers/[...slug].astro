---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import Paper from '../../../layouts/Paper.astro';
import { filterEnglishOnly, pickLocalized } from '../../../i18n';

export async function getStaticPaths() {
	const all = await getCollection('papers');
	const englishOnly = filterEnglishOnly(all);
	return englishOnly.map((english) => {
		const entry = pickLocalized(all, english, 'zh-tw');
		return {
			params: { slug: english.id },
			props: { entry, locale: 'zh-tw' as const },
		};
	});
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Paper {...entry.data} locale="zh-tw">
	<Content />
</Paper>
