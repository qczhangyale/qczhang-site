---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
import { getPaperCounts } from '../lib/paper-stats';
import { t } from '../i18n';

const description =
	'About Q.C. Zhang and the two research series: Complementarity-First and Twistor Configuration Geometry.';
const locale = 'en';
const counts = await getPaperCounts();
// Every number on this page is read from the content collection, so the prose
// cannot drift as records are added.
const vars = {
	total: counts.total,
	cf: counts.cf,
	cfRelease1: counts.cfRelease1,
	cfRelease2: counts.cfRelease2,
	cfRelease3: counts.cfRelease3,
	tcg: counts.tcg,
	tcgArc: counts.tcgArc,
	adjacent: counts.adjacent,
};
const bold = (key: string) =>
	t(locale, key, vars).replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');

// JSON-LD Person schema — feeds Google Knowledge Graph
const personSchema = {
	'@context': 'https://schema.org',
	'@type': 'Person',
	name: 'Q.C. Zhang',
	url: new URL('/', Astro.site).toString(),
	mainEntityOfPage: new URL('/about/', Astro.site).toString(),
	image: new URL('/og-image.png', Astro.site).toString(),
	jobTitle: 'Independent researcher in theoretical physics',
	email: 'mailto:qczhang@aya.yale.edu',
	knowsAbout: [
		'Theoretical physics',
		'Foundations of physics',
		'Foundations of quantum mechanics',
		'Complementarity-First',
		'Relational time',
		'Twistor theory',
		'Quantum gravity',
		'Cosmological constant',
		'Configurable Universe',
		'Twistor Configuration Geometry',
	],
	subjectOf: [
		{ '@type': 'CreativeWork', name: 'Complementarity-First research series', url: new URL('/', Astro.site).toString() },
		{ '@type': 'CreativeWork', name: 'Twistor Configuration Geometry research series', url: new URL('/tcg/', Astro.site).toString() },
	],
};
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`About — ${SITE_TITLE}`} description={description} schema={personSchema} />
		<style>
			.page-header {
				padding: 3rem 1rem 1.5rem;
				border-bottom: 1px solid var(--border);
				background: var(--bg-subtle);
			}
			.page-header-inner {
				max-width: var(--page-width);
				margin: 0 auto;
			}
			.page-eyebrow {
				font-family: var(--font-sans);
				font-size: 0.78rem;
				font-weight: 600;
				color: var(--accent);
				letter-spacing: 0.12em;
				text-transform: uppercase;
				margin-bottom: 0.6rem;
			}
			.page-header h1 {
				margin: 0 0 0.3em 0;
				font-size: 2.1rem;
				letter-spacing: -0.02em;
			}
			.lede {
				font-family: var(--font-serif);
				font-size: 1.15rem;
				color: var(--text-muted);
				font-style: italic;
				margin: 0;
				line-height: 1.5;
				max-width: 600px;
			}
			main {
				max-width: var(--page-width);
				margin: 0 auto;
				padding: 2.5rem 1rem 1rem;
			}
			h2 {
				margin-top: 2.5em;
				font-size: 1.3rem;
			}
			.contact-card {
				margin-top: 3rem;
				padding: 1.5em 1.6em;
				background: var(--bg-subtle);
				border-left: 3px solid var(--accent);
				border-radius: 6px;
			}
			.contact-card h3 {
				margin: 0 0 0.5em 0;
				font-size: 1rem;
			}
			.contact-card p {
				margin-bottom: 0.5em;
				color: var(--text-muted);
				font-size: 0.95rem;
			}
		</style>
	</head>
	<body>
		<Header />
		<div class="page-header">
			<div class="page-header-inner">
				<div class="page-eyebrow">{t(locale, 'about.eyebrow')}</div>
				<h1>{t(locale, 'about.title')}</h1>
				<p class="lede">{t(locale, 'about.lede')}</p>
			</div>
		</div>

		<main>
			<p set:html={bold('about.intro')}></p>

			<h2>{t(locale, 'about.cf')}</h2>
			<p set:html={bold('about.cfBody')}></p>
			<p>
				<a href="/">Browse the Complementarity-First records →</a>
			</p>

			<h2>{t(locale, 'about.tcg')}</h2>
			<p set:html={bold('about.framework')}></p>
			<p>
				<a href="/tcg/">Browse the Twistor Configuration Geometry arcs →</a>
			</p>

			<h2>{t(locale, 'about.empiricalAnchor')}</h2>
			<p set:html={bold('about.empiricalAnchorBody')}></p>

			<h2>{t(locale, 'about.prediction')}</h2>
			<p>
				{t(locale, 'about.predictionBody')} {t(locale, 'about.predictionExtra')}
				{' '}See the <a href="/papers/04-predictions-no-go/">Predictions ledger</a>.
			</p>

			<h2>{t(locale, 'about.corpus')}</h2>
			<p>
				{t(locale, 'about.corpusBody', vars)} See the <a href="/papers/">full list</a>.
			</p>

			<div class="contact-card">
				<h3>{t(locale, 'about.contact')}</h3>
				<p>
					{t(locale, 'about.contactEmail')}: <a href="mailto:qczhang@aya.yale.edu">qczhang@aya.yale.edu</a>
				</p>
				<p style="margin-bottom: 0;">
					{t(locale, 'about.contactOpen')}
				</p>
			</div>
		</main>

		<Footer />
	</body>
</html>
