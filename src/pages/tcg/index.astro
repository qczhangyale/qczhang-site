---
import BaseHead from '../../components/BaseHead.astro';
import TcgHubBody from '../../components/TcgHubBody.astro';
import { t } from '../../i18n';
import { SITE_TITLE } from '../../consts';

const locale = 'en' as const;
const title = `${t(locale, 'tcg.title')} — ${SITE_TITLE}`;
const description = t(locale, 'tcg.tagline');
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
	</head>
	<body>
		<TcgHubBody locale={locale} />
	</body>
</html>
