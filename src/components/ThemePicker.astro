---
// Theme picker — three themes: daylight, warm, dark.
// Click a button to set [data-theme] on <html>; persists in localStorage.
// Initial application happens in BaseHead.astro to prevent flash-of-wrong-theme.
---

<div class="theme-picker" role="group" aria-label="Color theme">
	<button type="button" data-theme-set="daylight" aria-label="Daylight theme" title="Daylight — cool, clear-day feel">
		<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
			<circle cx="12" cy="12" r="4"></circle>
			<path d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32l1.41 1.41M2 12h2m16 0h2M4.93 19.07l1.41-1.41m11.32-11.32l1.41-1.41"></path>
		</svg>
	</button>
	<button type="button" data-theme-set="warm" aria-label="Warm theme" title="Warm — cream paper, navy accent">
		<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
			<path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.07-2.14-.22-4.05 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.15.43-2.29 1-3a2.5 2.5 0 0 0 2.5 2.5z"></path>
		</svg>
	</button>
	<button type="button" data-theme-set="dark" aria-label="Dark theme" title="Dark — deep canvas, blue accent">
		<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
			<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
		</svg>
	</button>
</div>

<style>
	.theme-picker {
		display: inline-flex;
		gap: 0;
		padding: 2px;
		background: var(--bg-subtle);
		border: 1px solid var(--border);
		border-radius: 999px;
	}
	.theme-picker button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 28px;
		height: 28px;
		padding: 0;
		border: none;
		border-radius: 999px;
		background: transparent;
		color: var(--text-faint);
		cursor: pointer;
		transition: background 0.15s, color 0.15s;
	}
	.theme-picker button:hover {
		color: var(--text);
	}
	.theme-picker button[aria-pressed="true"] {
		background: var(--bg-elevated);
		color: var(--accent);
		box-shadow: var(--shadow-sm);
	}
	.theme-picker button:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 2px;
	}

	@media (max-width: 640px) {
		.theme-picker button {
			width: 26px;
			height: 26px;
		}
	}
</style>

<script is:inline>
	(function () {
		const STORAGE_KEY = 'qcz-theme';
		const VALID = ['daylight', 'warm', 'dark'];

		function getCurrent() {
			return document.documentElement.getAttribute('data-theme') || 'dark';
		}

		function applyTheme(theme) {
			if (!VALID.includes(theme)) theme = 'dark';
			document.documentElement.setAttribute('data-theme', theme);
			try { localStorage.setItem(STORAGE_KEY, theme); } catch (e) {}
			updatePressed(theme);
		}

		function updatePressed(theme) {
			document.querySelectorAll('.theme-picker button[data-theme-set]').forEach(function (btn) {
				const isActive = btn.getAttribute('data-theme-set') === theme;
				btn.setAttribute('aria-pressed', isActive ? 'true' : 'false');
			});
		}

		// Initial pressed state on load
		updatePressed(getCurrent());

		// Click handler (event delegation in case multiple pickers exist)
		document.addEventListener('click', function (e) {
			const btn = e.target.closest('[data-theme-set]');
			if (!btn) return;
			applyTheme(btn.getAttribute('data-theme-set'));
		});

		// Sync across tabs
		window.addEventListener('storage', function (e) {
			if (e.key === STORAGE_KEY && VALID.includes(e.newValue)) {
				applyTheme(e.newValue);
			}
		});
	})();
</script>
