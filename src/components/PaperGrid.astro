---
// A grid of paper cards. Shared by the two series hubs and the bibliography
// so the card markup exists in exactly one place.
import type { CollectionEntry } from 'astro:content';
import { type Locale } from '../i18n';
import { categoryLabel } from '../lib/series';

interface Props {
	papers: CollectionEntry<'papers'>[];
	locale?: Locale;
	/** Show the "№ NN" ordinal. Off for CF, which uses release codes instead. */
	showNumber?: boolean;
}
const { papers, locale = 'en', showNumber = true } = Astro.props;
const prefix = locale === 'en' ? '' : '/' + locale;
---

<div class="papers-grid">
	{
		papers.map((p) => (
			<a href={`${prefix}/papers/${p.id}/`} class="paper-card">
				<div class="paper-meta">
					<span class={`badge badge-${p.data.category}`}>
						{categoryLabel(locale, p.data.category)}
					</span>
					{p.data.code && <span class="badge-code">{p.data.code}</span>}
					{p.data.precision && <span class="badge-precision">{p.data.precision}</span>}
					{showNumber && !p.data.code && (
						<span class="paper-num">№ {String(p.data.order).padStart(2, '0')}</span>
					)}
				</div>
				<h3>{p.data.shortTitle ?? p.data.title}</h3>
				<p class="description">{p.data.description}</p>
				<div class="doi">{p.data.doi}</div>
			</a>
		))
	}
</div>

<style>
	.papers-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
		gap: 1rem;
	}
	.paper-card {
		display: flex;
		flex-direction: column;
		padding: 1.3em 1.4em;
		background: var(--bg-elevated);
		border: 1px solid var(--border);
		border-radius: 8px;
		text-decoration: none;
		color: inherit;
		transition: transform 0.15s, box-shadow 0.15s, border-color 0.15s;
	}
	.paper-card:hover {
		transform: translateY(-1px);
		box-shadow: var(--shadow-md);
		border-color: var(--border-strong);
		text-decoration: none;
	}
	.paper-meta {
		display: flex;
		gap: 0.5rem;
		align-items: center;
		margin-bottom: 0.7em;
		flex-wrap: wrap;
	}
	.paper-num {
		font-family: var(--font-mono);
		font-size: 0.78rem;
		color: var(--text-faint);
	}
	.paper-card h3 {
		margin: 0 0 0.5em 0;
		font-size: 1.05rem;
		line-height: 1.3;
		font-family: var(--font-sans);
	}
	.paper-card .description {
		color: var(--text-muted);
		margin: 0;
		font-size: 0.92rem;
		line-height: 1.55;
		flex: 1;
	}
	.paper-card .doi {
		margin-top: 0.9em;
		padding-top: 0.7em;
		border-top: 1px solid var(--border);
		font-family: var(--font-mono);
		font-size: 0.78rem;
		color: var(--text-faint);
	}
</style>
