---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';
import 'katex/dist/katex.min.css';
import type { ImageMetadata } from 'astro';
import { SITE_TITLE } from '../consts';
import { Font } from 'astro:assets';

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata;
	/** Optional JSON-LD object embedded in <script type="application/ld+json">.
	 *  Pass page-specific schemas (Person, ScholarlyArticle, BlogPosting, …);
	 *  if omitted, a WebSite schema is emitted by default. */
	schema?: Record<string, any> | Array<Record<string, any>>;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const { title, description, image, schema } = Astro.props;

// Strip any locale prefix from the current path so we can emit hreflang
// alternates for the three locales pointing at the same content.
const pathname = Astro.url.pathname;
const localelessPath = pathname.replace(/^\/(zh-cn|zh-tw)\//, '/').replace(/^\/(zh-cn|zh-tw)$/, '/');
const altEn = new URL(localelessPath, Astro.site).toString();
const altZhCn = new URL('/zh-cn' + (localelessPath === '/' ? '/' : localelessPath), Astro.site).toString();
const altZhTw = new URL('/zh-tw' + (localelessPath === '/' ? '/' : localelessPath), Astro.site).toString();

// Default schema — a WebSite blob so every page has at least basic structured data.
const defaultSchema = {
	'@context': 'https://schema.org',
	'@type': 'WebSite',
	name: SITE_TITLE,
	url: Astro.site?.toString() ?? 'https://qczhang.com/',
	description,
	inLanguage: 'en',
	author: {
		'@type': 'Person',
		name: 'Q.C. Zhang',
		url: new URL('/about/', Astro.site).toString(),
	},
};
const schemaToEmit = schema ?? defaultSchema;
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="color-scheme" content="light dark" />

<!-- Theme: apply immediately to avoid flash-of-wrong-theme.
     Reads localStorage; falls back to OS prefers-color-scheme then warm. -->
<script is:inline>
	(function () {
		try {
			// Clean up legacy dark-variant key if present
			try { localStorage.removeItem('qcz-dark-variant'); } catch (e) {}

			var stored = localStorage.getItem('qcz-theme');
			var valid = ['daylight', 'warm', 'dark'];
			// Migrate legacy values: 'light' → 'warm', 'sepia' → 'warm'
			if (stored === 'light' || stored === 'sepia') {
				stored = 'warm';
				try { localStorage.setItem('qcz-theme', 'warm'); } catch (e) {}
			}
			var theme;
			if (stored && valid.indexOf(stored) !== -1) {
				theme = stored;
			} else {
				// Default to dark for first-time visitors regardless of OS preference.
				// Users can still pick warm or daylight from the theme picker; their
				// choice is persisted in localStorage and overrides this default.
				theme = 'dark';
			}
			document.documentElement.setAttribute('data-theme', theme);
		} catch (e) {
			document.documentElement.setAttribute('data-theme', 'dark');
		}
	})();
</script>

<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" href="/favicon.ico" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL('rss.xml', Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

<Font cssVariable="--font-atkinson" preload />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- hreflang alternates — point search engines at the right locale variant -->
<link rel="alternate" hreflang="en" href={altEn} />
<link rel="alternate" hreflang="zh-CN" href={altZhCn} />
<link rel="alternate" hreflang="zh-TW" href={altZhTw} />
<link rel="alternate" hreflang="x-default" href={altEn} />

<!-- Structured data (JSON-LD) — Person / ScholarlyArticle / BlogPosting / WebSite -->
<script type="application/ld+json" set:html={JSON.stringify(schemaToEmit)} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook / LinkedIn -->
<meta property="og:type" content="website" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:site_name" content={SITE_TITLE} />
{image
	? <meta property="og:image" content={new URL(image.src, Astro.url)} />
	: <meta property="og:image" content={new URL('/og-image.png', Astro.site)} />
}
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:alt" content={title} />

<!-- Twitter / X -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
{image
	? <meta property="twitter:image" content={new URL(image.src, Astro.url)} />
	: <meta property="twitter:image" content={new URL('/og-image.png', Astro.site)} />
}
