---
import { t, localeFromPath, type Locale } from '../i18n';

const locale: Locale = localeFromPath(Astro.url.pathname);
const label = t(locale, 'share.label');
const showWeibo = locale === 'zh-cn' || locale === 'zh-tw';
---

<div class="share-wrap">
	<button
		type="button"
		class="share-btn"
		data-share-toggle
		aria-label={label}
		title={label}
		aria-haspopup="menu"
		aria-expanded="false"
	>
		<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
			<circle cx="18" cy="5" r="3"></circle>
			<circle cx="6" cy="12" r="3"></circle>
			<circle cx="18" cy="19" r="3"></circle>
			<line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
			<line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
		</svg>
	</button>

	<div class="share-menu" role="menu" hidden
		data-msg-copied={t(locale, 'share.linkCopied')}
		data-msg-failed={t(locale, 'share.copyFailed')}
		data-msg-paste-hint={t(locale, 'share.linkedinPasteHint')}
	>
		<button type="button" class="share-item" role="menuitem" data-share-action="copy">
			<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
				<path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
			</svg>
			<span>{t(locale, 'share.copy')}</span>
		</button>

		<button type="button" class="share-item" role="menuitem" data-share-action="twitter">
			<svg viewBox="0 0 24 24" width="13" height="13" fill="currentColor" aria-hidden="true">
				<path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
			</svg>
			<span>{t(locale, 'share.twitter')}</span>
		</button>

		<button type="button" class="share-item" role="menuitem" data-share-action="linkedin">
			<svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true">
				<path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.063 2.063 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
			</svg>
			<span>{t(locale, 'share.linkedin')}</span>
		</button>

		{showWeibo && (
			<button type="button" class="share-item" role="menuitem" data-share-action="weibo">
				<svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true">
					<path d="M9.83 19.32c-3.79 0-6.85-1.86-6.85-4.34 0-2.49 3.06-4.35 6.85-4.35 3.79 0 6.85 1.86 6.85 4.35 0 2.48-3.06 4.34-6.85 4.34zM10.34 12.4c-2.66 0-4.81 1.31-4.81 2.93s2.15 2.92 4.81 2.92c2.65 0 4.8-1.3 4.8-2.92s-2.15-2.93-4.8-2.93zm-.34 4.93c-1.05 0-1.9-.7-1.9-1.55 0-.86.85-1.55 1.9-1.55s1.9.69 1.9 1.55c0 .85-.85 1.55-1.9 1.55zm10.41-9.69a4.74 4.74 0 0 0-3.18-1.5c-.34-.04-.7.06-.94.32-.48.5-.32 1.2.32 1.55a3.18 3.18 0 0 1 1.94 2.4c.04.32.13.66.34.91.5.55 1.4.34 1.55-.34.32-1.2 0-2.4-.66-3.34zm-1.95-3.34a8.05 8.05 0 0 0-5.4-2.4c-.4-.04-.85.06-1.06.4-.4.55-.13 1.34.55 1.55 2.06.55 3.85 1.85 5.06 3.85.32.55.85.85 1.4.7.7-.13 1.06-.85.7-1.55-.32-.85-.85-1.7-1.25-2.55z"/>
				</svg>
				<span>{t(locale, 'share.weibo')}</span>
			</button>
		)}
	</div>

	<span class="share-toast" aria-live="polite"></span>
</div>

<style>
	.share-wrap {
		position: relative;
		display: inline-flex;
	}

	.share-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 32px;
		height: 32px;
		padding: 0;
		border: 1px solid var(--border);
		border-radius: 999px;
		background: var(--bg-subtle);
		color: var(--text-faint);
		cursor: pointer;
		transition: color 0.15s, background 0.15s, border-color 0.15s;
	}
	.share-btn:hover,
	.share-btn[aria-expanded="true"] {
		color: var(--text);
		background: var(--bg-elevated);
		border-color: var(--border-strong);
	}
	.share-btn:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 2px;
	}

	/* Popover menu */
	.share-menu {
		position: absolute;
		top: calc(100% + 0.5rem);
		right: 0;
		min-width: 180px;
		padding: 0.4rem;
		background: var(--bg-elevated);
		border: 1px solid var(--border);
		border-radius: 8px;
		box-shadow: var(--shadow-lg);
		z-index: 200;
		display: flex;
		flex-direction: column;
		gap: 1px;
		animation: share-menu-in 0.14s ease-out;
	}
	.share-menu[hidden] { display: none; }

	@keyframes share-menu-in {
		from { opacity: 0; transform: translateY(-4px); }
		to { opacity: 1; transform: translateY(0); }
	}

	.share-item {
		display: flex;
		align-items: center;
		gap: 0.7rem;
		padding: 0.55em 0.85em;
		background: transparent;
		border: none;
		border-radius: 5px;
		color: var(--text);
		font-family: var(--font-sans);
		font-size: 0.88rem;
		font-weight: 500;
		text-align: left;
		cursor: pointer;
		transition: background 0.12s, color 0.12s;
		white-space: nowrap;
	}
	.share-item:hover,
	.share-item:focus-visible {
		background: var(--bg-subtle);
		color: var(--accent);
		outline: none;
	}
	.share-item svg {
		flex-shrink: 0;
		color: var(--text-muted);
		transition: color 0.12s;
	}
	.share-item:hover svg,
	.share-item:focus-visible svg {
		color: var(--accent);
	}

	/* Toast feedback (for copy action) */
	.share-toast {
		position: absolute;
		top: calc(100% + 0.5rem);
		right: 0;
		background: var(--text);
		color: var(--bg);
		font-family: var(--font-sans);
		font-size: 0.75rem;
		font-weight: 500;
		padding: 0.4em 0.8em;
		border-radius: 4px;
		white-space: nowrap;
		pointer-events: none;
		opacity: 0;
		transform: translateY(-2px);
		transition: opacity 0.18s, transform 0.18s;
		box-shadow: var(--shadow-md);
		z-index: 250;
	}
	.share-toast.visible {
		opacity: 1;
		transform: translateY(0);
	}

	@media (max-width: 640px) {
		.share-btn { width: 30px; height: 30px; }
		.share-menu { min-width: 200px; }
	}
</style>

<script is:inline>
	(function () {
		let openMenu = null;

		function closeMenu() {
			if (!openMenu) return;
			const btn = openMenu.previousElementSibling;
			openMenu.setAttribute('hidden', '');
			if (btn) btn.setAttribute('aria-expanded', 'false');
			openMenu = null;
		}

		function showToast(wrap, text) {
			const toast = wrap.querySelector('.share-toast');
			if (!toast) return;
			toast.textContent = text;
			toast.classList.add('visible');
			setTimeout(function () { toast.classList.remove('visible'); }, 1600);
		}

		function copyToClipboard(url) {
			if (navigator.clipboard && navigator.clipboard.writeText) {
				return navigator.clipboard.writeText(url);
			}
			return new Promise(function (resolve, reject) {
				try {
					const ta = document.createElement('textarea');
					ta.value = url;
					ta.setAttribute('readonly', '');
					ta.style.position = 'fixed';
					ta.style.opacity = '0';
					ta.style.pointerEvents = 'none';
					document.body.appendChild(ta);
					ta.select();
					const ok = document.execCommand('copy');
					document.body.removeChild(ta);
					ok ? resolve() : reject(new Error('execCommand returned false'));
				} catch (e) { reject(e); }
			});
		}

		document.addEventListener('click', function (e) {
			// Open / close on button click
			const toggle = e.target.closest('[data-share-toggle]');
			if (toggle) {
				e.preventDefault();
				const menu = toggle.nextElementSibling;
				if (!menu) return;
				if (openMenu === menu) {
					closeMenu();
				} else {
					closeMenu();
					menu.removeAttribute('hidden');
					toggle.setAttribute('aria-expanded', 'true');
					openMenu = menu;
				}
				return;
			}

			// Action click
			const item = e.target.closest('[data-share-action]');
			if (item) {
				e.preventDefault();
				const action = item.getAttribute('data-share-action');
				const menu = item.closest('.share-menu');
				const wrap = item.closest('.share-wrap');
				const url = window.location.href;
				const title = document.title;

				// Pull the page meta description so we can pre-populate the post body
				// with real context, not just the URL. Falls back to title if missing.
				const descMeta = document.querySelector('meta[name="description"]')
					|| document.querySelector('meta[property="og:description"]');
				const description = descMeta ? (descMeta.getAttribute('content') || '') : '';
				const composedText = description
					? title + '\n\n' + description + '\n\n' + url
					: title + '\n\n' + url;

				if (action === 'copy') {
					const msgCopied = menu.getAttribute('data-msg-copied') || 'Link copied';
					const msgFailed = menu.getAttribute('data-msg-failed') || 'Copy failed';
					copyToClipboard(url)
						.then(function () { showToast(wrap, msgCopied); })
						.catch(function () { showToast(wrap, msgFailed); });
					closeMenu();
					return;
				}

				let target = null;
				if (action === 'twitter') {
					// X/Twitter renders an OG preview card from `url=`, and uses `text=` as
					// the tweet body. Title is enough — description bloats the tweet.
					target = 'https://twitter.com/intent/tweet?url=' + encodeURIComponent(url) +
						'&text=' + encodeURIComponent(title);
				} else if (action === 'linkedin') {
					// LinkedIn dropped support for pre-filled post text years ago and
					// only inconsistently honors the URL parameters. Most reliable UX:
					// copy title + description + URL to clipboard, then open LinkedIn's
					// composer. User pastes once with ⌘V — LinkedIn auto-detects the
					// URL and renders the full rich preview card with our og:image.
					const pasteHint = menu.getAttribute('data-msg-paste-hint')
						|| 'Text copied — paste in LinkedIn';
					copyToClipboard(composedText)
						.then(function () { showToast(wrap, pasteHint); })
						.catch(function () { /* still open LinkedIn even if copy fails */ });
					window.open(
						'https://www.linkedin.com/feed/?shareActive=true&shareUrl=' + encodeURIComponent(url),
						'_blank', 'noopener,noreferrer'
					);
					closeMenu();
					return;
				} else if (action === 'weibo') {
					// Weibo's `title` parameter populates the post text and supports
					// description-length content. Append description for richer context.
					const weiboTitle = description ? title + ' — ' + description : title;
					target = 'https://service.weibo.com/share/share.php?url=' + encodeURIComponent(url) +
						'&title=' + encodeURIComponent(weiboTitle);
				}

				if (target) {
					// Open in a new tab — popup blockers are friendlier to plain tabs.
					window.open(target, '_blank', 'noopener,noreferrer');
				}
				closeMenu();
				return;
			}

			// Click outside any menu — close
			if (openMenu && !e.target.closest('.share-wrap')) {
				closeMenu();
			}
		});

		// Escape key closes the menu
		document.addEventListener('keydown', function (e) {
			if (e.key === 'Escape' && openMenu) {
				closeMenu();
			}
		});
	})();
</script>
