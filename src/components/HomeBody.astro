---
// Homepage = the Complementarity-First page.
//
// CF supplies the relational foundation beneath TCG and is the current
// focus, so it is the front door rather than a section one click in. The
// provenance tree is this page's index — there is no separate paper-grid
// or separate CF-hub layer.
import { getCollection } from 'astro:content';
import { filterEnglishOnly, t, type Locale } from '../i18n';
import { getPaperCounts } from '../lib/paper-stats';
import {
	RELEASE,
	RELEASE_II,
	RELEASE_III,
	RELEASE_III_ARCS,
	READING_PATHS,
	OPEN_PROBLEMS,
	pathName,
	problemText,
	statusClass,
} from '../lib/cf-release';
import Header from './Header.astro';
import Footer from './Footer.astro';
import HomeArticle from './HomeArticle.astro';
import CfTree from './CfTree.astro';
import CfReleaseIITree from './CfReleaseIITree.astro';

interface Props {
	locale?: Locale;
}
const { locale = 'en' } = Astro.props;
const prefix = locale === 'en' ? '' : '/' + locale;
const counts = await getPaperCounts();

// Release date read from the corpus so the strapline cannot drift.
const cfPapers = filterEnglishOnly(await getCollection('papers')).filter(
	(p) => p.data.series === 'cf',
);
const released = new Date(Math.max(...cfPapers.map((p) => p.data.date.getTime())));
const fmt = (loc: string) =>
	released.toLocaleDateString(loc, { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });

const CODE_OF: Record<string, string> = {
	'cf-01-relational-unity': 'CF-F1',
	'cf-02-complementarity-before-quantum': 'CFQF-Q4',
	'cf-03-two-rebit-readout': 'CFQF-Q1',
	'cf-04-certificate-objectivity': 'CFQF-Q3',
	'cf-05-relational-time': 'CFQF-Q2',
	'cf-06-tcg-paired-incidence': 'TCG-F1',
	'cf-07-h2r-regge-transfer': 'CUD-G1',
	'cf-08-six-sector-reynolds': 'CUD-G2',
	'cf-09-unified-dynamics': 'CUD-U1',
	'cf-10-release-i-overview': 'CF-OV1',
};

const TOTAL_CF = RELEASE.records + RELEASE_II.records + RELEASE_III.records;
const s = (v: any) => v[locale] ?? v.en;
const copy = {
	// Two essays cover three releases: the older one has a Part I and a
	// Part II, so the tabs are anchors into it rather than separate pieces.
	tabsLabel: {
		en: 'Jump to a release',
		'zh-cn': '跳至某次发布',
		'zh-tw': '跳至某次發布',
	},
	tabI: { en: 'Release I', 'zh-cn': '发布 I', 'zh-tw': '發布 I' },
	tabII: { en: 'Release II', 'zh-cn': '发布 II', 'zh-tw': '發布 II' },
	tabIII: { en: 'Release III', 'zh-cn': '发布 III', 'zh-tw': '發布 III' },
	relIII: {
		en: 'Release III — Wave A',
		'zh-cn': '发布 III —— 第一波',
		'zh-tw': '發布 III —— 第一波',
	},
	relIIInote: {
		en: 'Grouped by arc. Hover a row for its summary; the title opens Zenodo. Wave A does not revise Releases I or II retroactively.',
		'zh-cn': '按弧分组。将鼠标悬停于任一行可查看摘要；点击标题跳转 Zenodo。第一波不会追溯性地修改发布 I 或 II。',
		'zh-tw': '按弧分組。將滑鼠懸停於任一行可查看摘要；點擊標題跳轉 Zenodo。第一波不會追溯性地修改發布 I 或 II。',
	},
	relIIIsub: {
		en: `Three records published ${RELEASE_III.published}: two preprints on reciprocal internal complementarity and a reproducibility dataset. Wave A opens the release; later waves are not published yet.`,
		'zh-cn': `${RELEASE_III.published} 发布的三条记录：两篇关于互反内在互补性的预印本与一份可复现数据集。第一波开启本次发布；后续各波尚未发布。`,
		'zh-tw': `${RELEASE_III.published} 發布的三條紀錄：兩篇關於互反內在互補性的預印本與一份可重現資料集。第一波開啟本次發布；後續各波尚未發布。`,
	},
	indexEyebrow: { en: 'The records', 'zh-cn': '记录', 'zh-tw': '紀錄' },
	// Sits with the release buttons rather than in the strapline: readers who
	// arrived looking for a paper rather than the essays get one affordance,
	// in the row that stays on screen.
	// Names the essay that follows, so the two embedded pieces do not run
	// together as one continuous article.
	essayIII: {
		en: 'Release III · Wave A',
		'zh-cn': '发布 III · 第一波',
		'zh-tw': '發布 III · 第一波',
	},
	tabPublications: {
		en: 'Publications',
		'zh-cn': '论文',
		'zh-tw': '論文',
	},
	indexTitle: {
		en: 'Browse the corpus',
		'zh-cn': '浏览语料库',
		'zh-tw': '瀏覽語料庫',
	},
	indexNote: {
		en: 'The records the article describes, arranged by structure rather than by narrative. Hover any row for its summary; titles open Zenodo.',
		'zh-cn': '文章所述的那些记录，按结构而非叙事排列。将鼠标悬停于任一行可查看摘要；点击标题跳转 Zenodo。',
		'zh-tw': '文章所述的那些紀錄，按結構而非敘事排列。將滑鼠懸停於任一行可查看摘要；點擊標題跳轉 Zenodo。',
	},
	relI: {
		en: 'Release I — building the grammar',
		'zh-cn': '发布 I —— 建立语法',
		'zh-tw': '發布 I —— 建立語法',
	},
	relIsub: {
		en: 'Ten records: the primitive relation, quantum foundations, finite/local gravity, and a bounded synthesis.',
		'zh-cn': '十条记录：原始关系、量子基础、有限／局域引力，以及一份有界的综合。',
		'zh-tw': '十條紀錄：原始關係、量子基礎、有限／局域重力，以及一份有界的綜合。',
	},
	relII: {
		en: 'Release II — time and electromagnetism',
		'zh-cn': '发布 II —— 时间与电磁学',
		'zh-tw': '發布 II —— 時間與電磁學',
	},
	relIIsub: {
		en: 'Eight records published 26 August 2026: three papers on time, three on electromagnetism, a reproducibility dataset, and an overview.',
		'zh-cn': '2026 年 8 月 26 日发布的八条记录：三篇时间论文、三篇电磁学论文、一份可复现数据集与一份总览。',
		'zh-tw': '2026 年 8 月 26 日發布的八條紀錄：三篇時間論文、三篇電磁學論文、一份可重現資料集與一份總覽。',
	},
	strapline: {
		en: `${TOTAL_CF} records across three Foundational Releases · published on Zenodo, CC-BY-4.0`,
		'zh-cn': `三次基础性发布共 ${TOTAL_CF} 条记录 · 发布于 Zenodo，CC-BY-4.0`,
		'zh-tw': `三次基礎性發布共 ${TOTAL_CF} 條紀錄 · 發布於 Zenodo，CC-BY-4.0`,
	},
	contactTitle: { en: 'About this site.', 'zh-cn': '关于本站。', 'zh-tw': '關於本站。' },
	contactBody: {
		en: "Q.C. Zhang's research site. All papers are on Zenodo under CC-BY-4.0.",
		'zh-cn': '张庆春的研究站点。全部论文以 CC-BY-4.0 协议发布于 Zenodo。',
		'zh-tw': '張慶春的研究站點。全部論文以 CC-BY-4.0 協議發布於 Zenodo。',
	},
	contactCta: {
		en: 'Open to criticism, collaboration, and pointers to related work. Contact',
		'zh-cn': '欢迎批评、合作，以及相关工作的线索。联系：',
		'zh-tw': '歡迎批評、合作，以及相關工作的線索。聯絡：',
	},
	allPapers: {
		en: `→ Full bibliography, both series (${counts.total})`,
		'zh-cn': `→ 两个系列的完整文献目录（${counts.total} 篇）`,
		'zh-tw': `→ 兩個系列的完整文獻目錄（${counts.total} 篇）`,
	},
};
---

<Header />

{/* Its own bar rather than a line inside the hero: sticky only works for as
    long as the containing block is on screen, and the hero is short enough
    that a sticky row inside it would scroll away almost immediately. */}
<div class="release-bar">
	<div class="release-bar-inner">
		<span class="eyebrow-label">{t(locale, 'cf.eyebrow')}</span>
		{/* Plain anchors, no JavaScript. Releases I and II land inside the
		    same essay — its Part I is the article's opening, its Part II
		    carries an explicit id written into all three editions. */}
		<nav class="release-tabs" aria-label={s(copy.tabsLabel)}>
			<a href="#cf-release-1">{s(copy.tabI)}</a>
			<a href="#cf-release-2">{s(copy.tabII)}</a>
			<a href="#cf-release-3">{s(copy.tabIII)}</a>
			<a class="tab-records" href="#records">{s(copy.tabPublications)}</a>
		</nav>
	</div>
</div>

<section class="hero">
	<div class="hero-inner">
		<h1>{t(locale, 'cf.title')}</h1>
		<p class="hero-tagline">{t(locale, 'cf.tagline')}</p>
		<p class="strapline">{s(copy.strapline)}</p>
	</div>
</section>

{/* Chronological: Releases I and II first, then Release III — so the tab
    order matches the order the essays appear in. */}
<HomeArticle locale={locale} anchor="cf-release-1" />

{/* The anchor sits on the label, not the article, so the jump lands on the
    "Release III · Wave A" line rather than below it. */}
<div class="essay-label" id="cf-release-3">
	<span>{s(copy.essayIII)}</span>
</div>
<HomeArticle locale={locale} slug="the-quantum-whole" />

<div class="section" id="records">
	<div class="section-eyebrow">{s(copy.indexEyebrow)}</div>
	<h2>{s(copy.indexTitle)}</h2>
	<p class="section-intro">{s(copy.indexNote)}</p>
</div>

<div class="section">
	<h2>{s(copy.relI)}</h2>
	<p class="section-intro">{s(copy.relIsub)}</p>
	<CfTree locale={locale} />
</div>

<div class="section">
	<h2>{s(copy.relII)}</h2>
	<p class="section-intro">{s(copy.relIIsub)}</p>
	<CfReleaseIITree locale={locale} />
</div>

<div class="section">
	<h2>{s(copy.relIII)}</h2>
	<p class="section-intro">{s(copy.relIIIsub)}</p>
	<CfReleaseIITree locale={locale} release={3} arcs={RELEASE_III_ARCS} note={s(copy.relIIInote)} />
</div>

<div class="section">
	<h2>{t(locale, 'cf.paths.title')}</h2>
	<p class="section-intro">{t(locale, 'cf.paths.note')}</p>
	<div class="paths">
		{
			READING_PATHS.map((p) => (
				<div class="path">
					<div class="path-name">{pathName(locale, p)}</div>
					<ol class="path-steps">
						{p.steps.map((id) => (
							<li>
								<a href={`${prefix}/papers/${id}/`}>{CODE_OF[id]}</a>
							</li>
						))}
					</ol>
				</div>
			))
		}
	</div>
</div>

<div class="section">
	<h2>{t(locale, 'cf.open.title')}</h2>
	<p class="section-intro">{t(locale, 'cf.open.note')}</p>
	<div class="op-wrapper">
		<table class="op-table">
			<tbody>
				{
					OPEN_PROBLEMS.map((p) => (
						<tr>
							<td class="op-id">{p.id}</td>
							<td class="op-status">
								<span class={`op-pill ${statusClass(p.status)}`}>{p.status}</span>
							</td>
							<td class="op-problem">{problemText(locale, p)}</td>
							<td class="op-owners">{p.owners.join(' · ')}</td>
						</tr>
					))
				}
			</tbody>
		</table>
	</div>
	<p class="rule-note">{t(locale, 'cf.discipline.body')}</p>
</div>

<div class="section">
	<div class="series-block">
		<div class="series-eyebrow">{t(locale, 'home.tcg.eyebrow')}</div>
		<h2>{t(locale, 'series.tcg.name')}</h2>
		<p>{t(locale, 'home.tcg.blurb', { n: counts.tcg })}</p>
		<p>{t(locale, 'cf.bridge.body')}</p>
		<p class="series-links">
			<a href={`${prefix}/tcg/`} class="btn btn-secondary">{t(locale, 'home.tcg.cta')}</a>
		</p>
	</div>
	<p class="all-papers-link">
		<a href={`${prefix}/papers/`}>{s(copy.allPapers)}</a>
	</p>
</div>

<div class="section">
	<div class="contact-block">
		<p>
			<strong>{s(copy.contactTitle)}</strong>
			{s(copy.contactBody)}
		</p>
		<p class="disclaimer">{t(locale, 'cf.notPeerReviewed')}</p>
		<p style="margin-bottom: 0;">
			{s(copy.contactCta)}
			<a href="mailto:qczhang@aya.yale.edu">qczhang@aya.yale.edu</a>.
		</p>
	</div>
</div>

<Footer />

<style>
	.hero {
		padding: 1.7rem 1rem 1.5rem;
		background: linear-gradient(180deg, var(--bg-subtle) 0%, var(--bg) 100%);
		border-bottom: 1px solid var(--border);
	}
	.hero-inner {
		max-width: var(--page-width-wide);
		margin: 0 auto;
	}
	/* Sticky strip under the header: label on the left, release anchors on the
	   right. Full-width so its background spans the viewport; the inner row
	   keeps the page measure. The anchor offset in global.css counts this
	   bar's height as well as the header's. */
	.release-bar {
		position: sticky;
		top: var(--header-h);
		z-index: 40;
		background: var(--header-bg);
		backdrop-filter: saturate(180%) blur(8px);
		border-bottom: 1px solid var(--border);
		/* Padding sits out here, exactly as .hero does it, so the inner row's
		   max-width centres against the same edges as the hero and sections
		   below. Putting it on the inner box instead shifts the label right. */
		padding: 0 1rem;
	}
	.release-bar-inner {
		max-width: var(--page-width-wide);
		margin: 0 auto;
		padding: 0.5rem 0;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.6rem;
	}
	.eyebrow-label {
		font-family: var(--font-sans);
		font-size: 0.72rem;
		font-weight: 600;
		color: var(--accent);
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}
	.hero h1 {
		font-size: 1.85rem;
		line-height: 1.12;
		margin: 0 0 0.25em 0;
		letter-spacing: -0.03em;
	}
	.hero-tagline {
		font-family: var(--font-serif);
		font-size: 1rem;
		color: var(--text-muted);
		font-style: italic;
		margin-bottom: 0;
	}

	.section {
		max-width: var(--page-width-wide);
		margin: 0 auto;
		padding: 1.9rem 1rem 0.5rem;
	}
	.section h2 {
		margin-top: 0;
		font-size: 1.55rem;
	}
	.section-intro {
		color: var(--text-muted);
		margin-bottom: 1.5rem;
		line-height: 1.6;
		max-width: 78ch;
	}
	/* Replaces the old stat block: same facts, a fraction of the height. */
	.strapline {
		margin: 0.8rem 0 0;
		font-family: var(--font-sans);
		font-size: 0.85rem;
		color: var(--text-faint);
		letter-spacing: 0.01em;
	}
	/* Names an embedded essay, above where it begins. Uses the article's
	   measure (--page-width), not the wider section measure, so it sits flush
	   with the prose it labels rather than 100px to its left. */
	.essay-label {
		max-width: var(--page-width);
		margin: 0 auto;
		padding: 2rem 1rem 0.5rem;
	}
	.essay-label span {
		font-family: var(--font-sans);
		font-size: 0.74rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--accent);
	}

	/* Release anchors, sitting on the hero's eyebrow line. */
	.release-tabs {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.35rem;
	}
	.release-tabs a {
		font-family: var(--font-sans);
		font-size: 0.8rem;
		font-weight: 600;
		letter-spacing: 0.02em;
		color: var(--text-muted);
		text-decoration: none;
		padding: 0.35em 0.9em;
		border: 1px solid var(--border);
		border-radius: 999px;
		background: var(--bg-subtle);
		transition: color 0.15s, background 0.15s, border-color 0.15s;
	}
	/* Goes to the record index rather than an essay, so it is set apart. */
	.release-tabs .tab-records {
		margin-left: 0.45rem;
		color: var(--accent);
		border-color: var(--border-strong);
	}
	.release-tabs a:hover,
	.release-tabs a:focus-visible {
		color: var(--accent);
		background: var(--bg-elevated);
		border-color: var(--border-strong);
		text-decoration: none;
	}


	/* Reading paths, compressed to code chips now that the tree carries titles. */
	.paths {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
		gap: 0.9rem;
	}
	.path {
		padding: 0.9em 1.1em;
		background: var(--bg-elevated);
		border: 1px solid var(--border);
		border-radius: 8px;
	}
	.path-name {
		font-family: var(--font-sans);
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--accent);
		margin-bottom: 0.6em;
	}
	.path-steps {
		margin: 0;
		padding: 0;
		list-style: none;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.3em;
	}
	.path-steps li:not(:last-child)::after {
		content: '→';
		color: var(--text-faint);
		margin-left: 0.35em;
		font-size: 0.8em;
	}
	.path-steps a {
		font-family: var(--font-mono);
		font-size: 0.76rem;
		color: var(--text-muted);
		text-decoration: none;
	}
	.path-steps a:hover {
		color: var(--accent);
		text-decoration: none;
	}

	.op-wrapper {
		border: 1px solid var(--border);
		border-radius: 8px;
		overflow: hidden;
		background: var(--bg-elevated);
	}
	.op-table {
		width: 100%;
		border-collapse: collapse;
		font-size: 0.92rem;
	}
	.op-table td {
		padding: 0.65em 1em;
		border-bottom: 1px solid var(--border);
		vertical-align: top;
	}
	.op-table tr:last-child td {
		border-bottom: none;
	}
	.op-id {
		font-family: var(--font-mono);
		font-size: 0.76rem;
		color: var(--text-faint);
		width: 1%;
		white-space: nowrap;
	}
	.op-status {
		width: 1%;
		white-space: nowrap;
	}
	.op-pill {
		display: inline-block;
		padding: 0.12em 0.5em;
		font-family: var(--font-mono);
		font-size: 0.68rem;
		letter-spacing: 0.03em;
		border-radius: 3px;
		border: 1px solid var(--border-strong);
		color: var(--text-muted);
	}
	.op-pill.op-hold {
		border-style: dashed;
	}
	.op-pill.op-none {
		opacity: 0.75;
	}
	.op-owners {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		color: var(--text-faint);
		text-align: right;
		white-space: nowrap;
		width: 1%;
	}
	.rule-note {
		margin: 1.2rem 0 0;
		font-size: 0.86rem;
		line-height: 1.6;
		color: var(--text-faint);
		max-width: 78ch;
	}

	.series-block {
		padding: 1.8em 1.8em;
		background: var(--bg-subtle);
		border-radius: 10px;
		border: 1px solid var(--border);
	}
	.series-eyebrow {
		font-family: var(--font-sans);
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--text-faint);
		margin-bottom: 0.5rem;
	}
	.series-block h2 {
		margin: 0 0 0.6rem;
	}
	.series-block p {
		color: var(--text-muted);
		line-height: 1.6;
	}
	.series-links {
		margin-bottom: 0;
		margin-top: 1.2rem;
	}

	.all-papers-link {
		margin: 1.4rem 0 0;
		text-align: right;
		font-family: var(--font-sans);
		font-size: 0.95rem;
	}
	.all-papers-link a {
		color: var(--accent);
		text-decoration: none;
		font-weight: 500;
	}

	.contact-block {
		margin-top: 2.5rem;
		padding: 1.5em 1.5em;
		background: var(--bg-subtle);
		border-radius: 8px;
		color: var(--text-muted);
		font-size: 0.95rem;
	}
	.contact-block strong {
		color: var(--text);
	}
	.disclaimer {
		font-size: 0.85rem;
		color: var(--text-faint);
		line-height: 1.6;
	}

	@media (max-width: 640px) {
		.hero h1 {
			font-size: 1.75rem;
