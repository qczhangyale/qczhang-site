---
import { Image } from 'astro:assets';
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
import ThemePicker from './ThemePicker.astro';
import LanguagePicker from './LanguagePicker.astro';
import ShareButton from './ShareButton.astro';
import { t, localeFromPath } from '../i18n';
import avatar from '../assets/avatar.jpg';

const locale = localeFromPath(Astro.url.pathname);
const localePrefix = locale === 'en' ? '' : '/' + locale;
---

<header>
	<div class="header-inner">
		<a href={localePrefix + '/'} class="brand">
			<Image src={avatar} alt="" width={72} height={72} class="brand-avatar" loading="eager" />
			<div class="brand-text">
				<span class="brand-name">{SITE_TITLE}</span>
				<span class="brand-tag">{t(locale, 'site.brandTag')}</span>
			</div>
		</a>
		<div class="header-right">
			<nav class="nav-links">
				<HeaderLink href={localePrefix + '/'}>{t(locale, 'nav.home')}</HeaderLink>
				<HeaderLink href={localePrefix + '/papers'}>{t(locale, 'nav.papers')}</HeaderLink>
				<HeaderLink href={localePrefix + '/blog'}>{t(locale, 'nav.posts')}</HeaderLink>
				<HeaderLink href={localePrefix + '/about'}>{t(locale, 'nav.about')}</HeaderLink>
			</nav>
			<LanguagePicker />
			<ThemePicker />
			<ShareButton />
		</div>
	</div>
</header>

<style>
	header {
		border-bottom: 1px solid var(--border);
		position: sticky;
		top: 0;
		z-index: 50;
		backdrop-filter: saturate(180%) blur(8px);
		background: var(--header-bg);
	}
	.header-right {
		display: flex;
		align-items: center;
		gap: 0.7rem;
	}

	.header-inner {
		max-width: var(--page-width-wide);
		margin: 0 auto;
		padding: 0.9em 1.5rem;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 2rem;
	}

	.brand {
		display: flex;
		flex-direction: row;
		align-items: center;
		gap: 0.7rem;
		text-decoration: none;
		color: var(--text);
		line-height: 1.2;
	}

	.brand-avatar {
		width: 36px;
		height: 36px;
		border-radius: 999px;
		object-fit: cover;
		border: 1px solid var(--border);
		flex-shrink: 0;
		transition: border-color 0.15s, transform 0.15s;
	}
	.brand:hover .brand-avatar {
		border-color: var(--accent);
		transform: scale(1.04);
	}

	.brand-text {
		display: flex;
		flex-direction: column;
	}

	.brand:hover {
		text-decoration: none;
		color: var(--accent);
	}

	.brand-name {
		font-family: var(--font-sans);
		font-weight: 700;
		font-size: 1.05rem;
		letter-spacing: -0.01em;
	}

	.brand-tag {
		font-family: var(--font-sans);
		font-size: 0.72rem;
		color: var(--text-faint);
		font-weight: 500;
		letter-spacing: 0.02em;
		margin-top: 0.1em;
	}

	.nav-links {
		display: flex;
		gap: 0.3em;
	}

	.nav-links :global(a) {
		font-family: var(--font-sans);
		font-size: 0.92rem;
		padding: 0.4em 0.85em;
		color: var(--text-muted);
		text-decoration: none;
		border-radius: 4px;
		transition: color 0.15s, background 0.15s;
	}

	.nav-links :global(a:hover) {
		color: var(--accent);
		background: var(--bg-subtle);
		text-decoration: none;
	}

	.nav-links :global(a.active) {
		color: var(--accent);
		font-weight: 600;
	}

	@media (max-width: 720px) {
		.header-inner {
			padding: 0.7em 1rem;
			gap: 0.7rem;
			flex-wrap: wrap;
		}
		.brand-tag {
			display: none;
		}
		.brand-avatar {
			width: 32px;
			height: 32px;
		}
		.brand {
			gap: 0.55rem;
		}
		.nav-links :global(a) {
			padding: 0.4em 0.5em;
			font-size: 0.88rem;
		}
		.header-right {
			gap: 0.5rem;
		}
	}
</style>
