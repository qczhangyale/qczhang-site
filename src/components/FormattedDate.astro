---
interface Props {
	date: Date;
}

const { date } = Astro.props;
---

<time datetime={date.toISOString()}>
	{
		date.toLocaleDateString('en-us', {
			year: 'numeric',
			month: 'short',
			day: 'numeric',
			// Frontmatter dates are bare YYYY-MM-DD, parsed as UTC midnight.
			// Without this the string is formatted in the build machine's local
			// zone and every date west of UTC renders one day early.
			timeZone: 'UTC',
		})
	}
</time>
